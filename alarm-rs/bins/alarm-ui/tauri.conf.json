{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alarm",
  "mainBinaryName": "alarm-ui",
  "version": "1.0.0",
  "identifier": "org.alarmrs.Alarm",
  "build": {
    "frontendDist": "../../crates/ui-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Alarm clock",
    "copyright": "",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "wix": { "language": "en-US" }
    }
  }
}
